<Stackup schemaVersion="3.1">
  <!-- Created/modified using the XML Stackup Editor in setupEM -->
  <!-- ============================================================ -->
  <!-- File description: Thermal model for use with gds2palace and Elmer solver.
IHP interposer technology based on SG13.
Silicon thermal values from literature (not actual IHP data).
Thermal conductivity values defined using variables, since several materials share the
same value. Density is omitted throughout - not used by this model, defaults to 1 in the
reader. Substrate thickness (Dielectric, Substrate Offset, and the LBE/BACKSIDEGND Layers
below it) defined using a variable too, since that dimension is otherwise repeated in
several places. -->
  <!-- <Variables>/"="-expressions require gds2palace util_stackup_reader.py version 1.7.0 or newer -->
  <Variables>
    <Variable Name="k_metal"            Value="237" />
    <Variable Name="k_via"              Value="174" />
    <Variable Name="k_passive"          Value="0.5" />
    <Variable Name="k_oxide"            Value="1" />
    <Variable Name="k_lowloss"          Value="100" />
    <Variable Name="k_air"              Value="0.026" />
    <Variable Name="total_thickness" Value="250.0" />
    <Variable Name="substrate_thickness" Value="=total_thickness-12.4704" />
    
  </Variables>
  <Materials>
    <Material Name="Metal4" Type="Conductor" Conductivity="23190000.0" ThermalConductivity="=k_metal" Color="93e837" />
    <Material Name="Metal5" Type="Conductor" Conductivity="23190000.0" ThermalConductivity="=k_metal" Color="dcd146" />
    <Material Name="TopMetal1" Type="Conductor" Conductivity="27800000.0" ThermalConductivity="=k_metal" Color="ffe6bf" />
    <Material Name="TopMetal2" Type="Conductor" Conductivity="30300000.0" ThermalConductivity="=k_metal" Color="ff8000" />
    <Material Name="TopVia2" Type="Conductor" Conductivity="3143000.0" ThermalConductivity="=k_via" Color="ff8000" />
    <Material Name="TopVia1" Type="Conductor" Conductivity="2191000.0" ThermalConductivity="=k_via" Color="ffe6bf" />
    <Material Name="Via4" Type="Conductor" Conductivity="1660000.0" ThermalConductivity="=k_via" Color="deac5e" />
    <Material Name="Passive" Type="Dielectric" Permittivity="6.6" DielectricLossTangent="0.0" ThermalConductivity="=k_passive" Color="a0a0f0" />
    <Material Name="SiO2" Type="Dielectric" Permittivity="4.1" DielectricLossTangent="0.0" ThermalConductivity="=k_oxide" Color="fffcad" />
    <Material Name="HighResSubstrate" Type="Semiconductor" Permittivity="11.9" DielectricLossTangent="0" Conductivity="0.025" ThermalConductivityTable="SiliconThermalCond" Color="01e0ff" />
    <Material Name="AIR" Type="Dielectric" Permittivity="1.0" DielectricLossTangent="0.0" ThermalConductivity="=k_air" Color="d0d0d0" />
    <Material Name="LOWLOSS" Type="Conductor" Conductivity="1E10" ThermalConductivity="=k_lowloss" Color="ff0000" />
    <Material Name="TFR" Type="Conductor" Conductivity="500000.0" ThermalConductivity="=k_lowloss" Color="aaaaaa" />
  </Materials>
  <Tables>
    <Table Name="SiliconThermalCond">
      <Point Temperature="280" Value="163.00" />
      <Point Temperature="290" Value="155.20" />
      <Point Temperature="300" Value="148.00" />
      <Point Temperature="310" Value="141.30" />
      <Point Temperature="320" Value="135.10" />
      <Point Temperature="330" Value="129.30" />
      <Point Temperature="340" Value="124.00" />
      <Point Temperature="350" Value="119.00" />
      <Point Temperature="360" Value="114.40" />
