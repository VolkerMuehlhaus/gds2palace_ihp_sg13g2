      <Point Temperature="420" Value="93.40" />
      <Point Temperature="430" Value="90.90" />
      <Point Temperature="440" Value="88.50" />
      <Point Temperature="450" Value="86.20" />
    </Table>
  </Tables>
  <ELayers LengthUnit="um">
    <Dielectrics>
      <Dielectric Name="Passive" Material="Passive" Thickness="0.4000" />
      <Dielectric Name="SiO2" Material="SiO2" Thickness="12.2703" />
      <Dielectric Name="Substrate_Interposer" Material="HighResSubstrate" Thickness="=substrate_thickness" />
    </Dielectrics>
    <Layers>
      <Substrate Offset="=substrate_thickness" />
      <Layer Name="Metal4" Type="conductor" Zmin="0.6000" Zmax="1.0900" Material="Metal4" Layer="50" />
      <Layer Name="TFR" Type="conductor" Zmin="1.1900" Zmax="1.2700" Material="TFR" Layer="146" />
