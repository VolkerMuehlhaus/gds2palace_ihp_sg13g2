#!/bin/bash
# Touchstone conversion and port de-embedding of the results in the current directory. Every model written by
# gds2palace 0.10.0 or later carries its own combine_extend_snp.py (the version that matches the model); older
# models fall back to the copy in ~/scripts. Adjust the Python interpreter (needs scikit-rf) to your machine.
script=~/scripts/combine_extend_snp.py
if [ -f ./combine_extend_snp.py ]; then
  script=./combine_extend_snp.py
fi
~/venv/palace/bin/python "$script" "$@"
